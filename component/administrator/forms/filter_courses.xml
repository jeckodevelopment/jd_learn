<?xml version="1.0" encoding="utf-8"?>
<form>
 <fields name="filter">
  <field name="search" type="text" inputmode="search" label="COM_JLMS_COURSES_SEARCH" description="COM_JLMS_COURSES_SEARCH_HELP" hint="JSEARCH_FILTER" maxlength="200" />
  <field name="published" type="list" label="JSTATUS" class="js-select-submit-on-change" validate="options"><option value="">JOPTION_SELECT_PUBLISHED</option><option value="1">JPUBLISHED</option><option value="0">JUNPUBLISHED</option></field>
  <field name="category_id" type="Coursefiltercategory" addfieldprefix="Jlms\Component\Jlms\Administrator\Field" extension="com_jlms.course" published="0,1,2" label="JCATEGORY" class="js-select-submit-on-change"><option value="">JOPTION_SELECT_CATEGORY</option></field>
  <field name="access" type="accesslevel" label="JGRID_HEADING_ACCESS" class="js-select-submit-on-change"><option value="">JOPTION_SELECT_ACCESS</option></field>
  <field name="author_id" type="Courseauthors" addfieldprefix="Jlms\Component\Jlms\Administrator\Field" label="JAUTHOR" class="js-select-submit-on-change"><option value="">JOPTION_SELECT_AUTHOR</option></field>
  <field name="language" type="contentlanguage" label="JGRID_HEADING_LANGUAGE" class="js-select-submit-on-change"><option value="">JOPTION_SELECT_LANGUAGE</option><option value="*">JALL</option></field>
  <field name="checked_out" type="list" label="COM_JLMS_COURSES_CHECKOUT" class="js-select-submit-on-change" validate="options"><option value="">COM_JLMS_COURSES_CHECKOUT</option><option value="1">COM_JLMS_COURSES_LOCKED</option><option value="0">COM_JLMS_COURSES_UNLOCKED</option></field>
 </fields>
 <fields name="list">
  <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" class="js-select-submit-on-change" default="a.id DESC" validate="options">
   <option value="a.id DESC">JGRID_HEADING_ID_DESC</option><option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
   <option value="a.title ASC">JGLOBAL_TITLE_ASC</option><option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
   <option value="a.state ASC">JSTATUS_ASC</option><option value="a.state DESC">JSTATUS_DESC</option>
   <option value="category_title ASC">JCATEGORY_ASC</option><option value="category_title DESC">JCATEGORY_DESC</option>
   <option value="access_title ASC">JGRID_HEADING_ACCESS_ASC</option><option value="access_title DESC">JGRID_HEADING_ACCESS_DESC</option>
   <option value="author_name ASC">JAUTHOR_ASC</option><option value="author_name DESC">JAUTHOR_DESC</option>
   <option value="a.language ASC">JGRID_HEADING_LANGUAGE_ASC</option><option value="a.language DESC">JGRID_HEADING_LANGUAGE_DESC</option>
   <option value="a.modified_at ASC">COM_JLMS_COURSES_MODIFIED_ASC</option><option value="a.modified_at DESC">COM_JLMS_COURSES_MODIFIED_DESC</option>
  </field>
  <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="20" class="js-select-submit-on-change" />
 </fields>
</form>

<?xml version="1.0" encoding="utf-8"?><form><fieldset name="details"><field name="id" type="hidden" default="0" filter="integer" />
<field name="revision" type="hidden" default="1" filter="integer" />
<field name="course_id" type="hidden" filter="integer" />
<field name="version_id" type="hidden" filter="integer" />
<field name="expected_version_revision" type="hidden" filter="integer" />
<field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" filter="string" />
<field name="module_id" type="list" label="COM_JLMS_MODULE" required="true" />
<field name="kind" type="list" label="COM_JLMS_LESSON_KIND" default="text"><option value="text">COM_JLMS_LESSON_TEXT</option><option value="video">COM_JLMS_LESSON_VIDEO</option></field>
<field name="required" type="radio" layout="joomla.form.field.radio.switcher" label="COM_JLMS_LESSON_REQUIRED" default="1"><option value="0">JNO</option><option value="1">JYES</option></field>
<field name="body" type="editor" label="COM_JLMS_LESSON_BODY" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
<field name="provider_key" type="list" label="COM_JLMS_VIDEO_PROVIDER" showon="kind:video" />
<field name="source_reference" type="text" label="COM_JLMS_VIDEO_SOURCE" maxlength="2048" showon="kind:video[AND]provider_key!:html5" />
<field name="privacy_hash" type="text" label="COM_JLMS_VIMEO_HASH" maxlength="256" showon="kind:video[AND]provider_key:vimeo" />
<field name="duration_mode" type="list" label="COM_JLMS_VIDEO_DURATION_MODE" default="auto" showon="kind:video[AND]provider_key!:html5"><option value="auto">COM_JLMS_VIDEO_DURATION_AUTO</option><option value="manual">COM_JLMS_VIDEO_DURATION_MANUAL</option></field>
<field name="duration_ticket" type="hidden" filter="string" />
<field name="sdk_duration_ms" type="hidden" filter="string" />
<field name="duration_seconds" type="number" label="COM_JLMS_VIDEO_DURATION_SECONDS" description="COM_JLMS_VIDEO_DURATION_DESC" min="1" max="28800" step="0.001" filter="string" showon="kind:video[AND]provider_key!:html5[AND]duration_mode:manual" />
<field name="duration_confirmed" type="hidden" default="0" filter="string" />
</fieldset></form>

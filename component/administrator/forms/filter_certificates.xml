<?xml version="1.0" encoding="utf-8"?>
<form>
 <fields name="filter">
  <field name="search" type="text" label="COM_JLMS_CERTIFICATE_SEARCH" hint="JSEARCH_FILTER" maxlength="120" />
  <field name="status" type="list" label="COM_JLMS_CERTIFICATE_FILTER_STATUS" class="js-select-submit-on-change" validate="options">
   <option value="">JALL</option>
   <option value="ready">COM_JLMS_CERTIFICATE_STATE_READY</option>
   <option value="pending_render">COM_JLMS_CERTIFICATE_STATE_PENDING</option>
   <option value="revoked">COM_JLMS_CERTIFICATE_STATE_REVOKED</option>
  </field>
 </fields>
 <fields name="list">
  <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" class="js-select-submit-on-change" default="d.issued_at DESC" validate="options">
   <option value="d.issued_at DESC">COM_JLMS_CERTIFICATE_SORT_ISSUED_DESC</option>
   <option value="d.issued_at ASC">COM_JLMS_CERTIFICATE_SORT_ISSUED_ASC</option>
   <option value="student_name ASC">COM_JLMS_CERTIFICATE_SORT_STUDENT_ASC</option>
   <option value="student_name DESC">COM_JLMS_CERTIFICATE_SORT_STUDENT_DESC</option>
   <option value="course_title ASC">COM_JLMS_CERTIFICATE_SORT_COURSE_ASC</option>
   <option value="course_title DESC">COM_JLMS_CERTIFICATE_SORT_COURSE_DESC</option>
   <option value="d.serial ASC">COM_JLMS_CERTIFICATE_SORT_CODE_ASC</option>
   <option value="d.serial DESC">COM_JLMS_CERTIFICATE_SORT_CODE_DESC</option>
   <option value="certificate_state ASC">COM_JLMS_CERTIFICATE_SORT_STATUS_ASC</option>
   <option value="certificate_state DESC">COM_JLMS_CERTIFICATE_SORT_STATUS_DESC</option>
   <option value="c.id ASC">COM_JLMS_CERTIFICATE_SORT_ID_ASC</option>
   <option value="c.id DESC">COM_JLMS_CERTIFICATE_SORT_ID_DESC</option>
  </field>
  <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="20" class="js-select-submit-on-change" />
 </fields>
</form>

<?xml version="1.0" encoding="utf-8"?>
<form><fieldset name="details" label="COM_JLMS_COURSE">
 <field name="id" type="hidden" filter="integer" default="0" />
 <field name="revision" type="hidden" filter="integer" default="1" />
 <field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" filter="string" />
 <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" maxlength="180" filter="string" />
 <field name="catid" type="category" extension="com_jlms.course" label="JCATEGORY" required="true" filter="integer" />

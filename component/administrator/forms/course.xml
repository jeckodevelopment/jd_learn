<?xml version="1.0" encoding="utf-8"?>
<form>
 <fieldset name="details" label="COM_JLMS_COURSE_GENERAL">
  <field name="id" type="hidden" filter="integer" default="0" />
  <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" filter="string" maxlength="255" />
  <field name="revision" type="hidden" filter="integer" default="1" />
  <field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" filter="string" />
  <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" maxlength="180" filter="string" />
  <field name="catid" type="Coursecategory" addfieldprefix="Jlms\Component\Jlms\Administrator\Field" published="0,1,2" extension="com_jlms.course" label="JCATEGORY" required="true" filter="integer" />
  <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL" default="*"><option value="*">JALL</option></field>
  <field name="tags" type="tag" label="COM_JLMS_COURSE_TAGS" description="COM_JLMS_COURSE_TAGS_DESC" multiple="true" />
  <field name="summary" type="textarea" label="COM_JLMS_COURSE_SUMMARY" description="COM_JLMS_COURSE_SUMMARY_LIMIT" filter="string" rows="4" />
 </fieldset>
 <fieldset name="presentation" label="COM_JLMS_COURSE_PRESENTATION">
  <field name="presentation_image" type="media" label="COM_JLMS_COURSE_IMAGE" description="COM_JLMS_COURSE_IMAGE_HELP" types="images" preview="tooltip" filter="raw" />
  <field name="presentation_image_alt" type="text" label="COM_JLMS_COURSE_IMAGE_ALT" maxlength="500" filter="raw" />
  <field name="presentation_image_decorative" type="radio" layout="joomla.form.field.radio.switcher" label="COM_JLMS_COURSE_IMAGE_DECORATIVE" default="0" filter="raw"><option value="0">JNO</option><option value="1">JYES</option></field>
  <field name="presentation_description" type="editor" label="COM_JLMS_COURSE_DESCRIPTION" description="COM_JLMS_COURSE_DESCRIPTION_PUBLICATION_HELP" filter="raw" buttons="false" height="300" />
  <field name="presentation_objectives" type="textarea" label="COM_JLMS_COURSE_OBJECTIVES" filter="raw" rows="4" />
  <field name="presentation_audience" type="textarea" label="COM_JLMS_COURSE_AUDIENCE" filter="raw" rows="4" />
  <field name="presentation_prerequisite_text" type="textarea" label="COM_JLMS_COURSE_PREREQUISITE_TEXT" description="COM_JLMS_COURSE_PREREQUISITE_HELP" filter="raw" rows="4" />
  <field name="presentation_difficulty" type="list" label="COM_JLMS_COURSE_DIFFICULTY" filter="raw" default="">
   <option value="">COM_JLMS_COURSE_NOT_SPECIFIED</option><option value="beginner">COM_JLMS_COURSE_BEGINNER</option><option value="intermediate">COM_JLMS_COURSE_INTERMEDIATE</option><option value="advanced">COM_JLMS_COURSE_ADVANCED</option>
  </field>
  <field name="presentation_estimated_minutes" type="number" label="COM_JLMS_COURSE_ESTIMATED_MINUTES" description="COM_JLMS_COURSE_ESTIMATED_HELP" min="1" step="1" filter="raw" />
 </fieldset>
 <fieldset name="access" label="COM_JLMS_COURSE_ACCESS_SETTINGS">
  <field name="catalog_access" type="accesslevel" label="COM_JLMS_CATALOG_ACCESS" default="1" filter="integer" required="true" />
  <field name="content_access" type="accesslevel" label="COM_JLMS_CONTENT_ACCESS" default="2" filter="integer" required="true" />
  <field name="enrollment_mode" type="list" description="COM_JLMS_EDITOR_MODE_HELP" label="COM_JLMS_ENROLLMENT_MODE" default="auto" required="true">
   <option value="auto">COM_JLMS_ENROLLMENT_AUTO</option><option value="explicit">COM_JLMS_ENROLLMENT_EXPLICIT</option><option value="approval">COM_JLMS_ENROLLMENT_APPROVAL</option>
  </field>
 </fieldset>
 <fieldset name="teachers" label="COM_JLMS_TEACHERS">
  <field name="teacher_ids" type="Courseteachers" addfieldprefix="Jlms\Component\Jlms\Administrator\Field" label="COM_JLMS_TEACHERS" description="COM_JLMS_TEACHER_ASSIGN_HELP" multiple="true" filter="raw" />
 </fieldset>
 <fieldset name="notifications" label="COM_JLMS_COURSE_MAIL_PREFERENCES">
  <field name="mail_enrollment" type="list" label="COM_JLMS_MAIL_ENROLLMENT_ENABLED" default="inherit" filter="cmd"><option value="inherit">COM_JLMS_MAIL_INHERIT_GLOBAL</option><option value="enabled">JYES</option><option value="disabled">JNO</option></field>
  <field name="mail_completion" type="list" label="COM_JLMS_MAIL_COMPLETION_ENABLED" default="inherit" filter="cmd"><option value="inherit">COM_JLMS_MAIL_INHERIT_GLOBAL</option><option value="enabled">JYES</option><option value="disabled">JNO</option></field>
  <field name="mail_suspension" type="list" label="COM_JLMS_MAIL_SUSPENSION_ENABLED" default="inherit" filter="cmd"><option value="inherit">COM_JLMS_MAIL_INHERIT_GLOBAL</option><option value="enabled">JYES</option><option value="disabled">JNO</option></field>
  <field name="mail_reactivation" type="list" label="COM_JLMS_MAIL_REACTIVATION_ENABLED" default="inherit" filter="cmd"><option value="inherit">COM_JLMS_MAIL_INHERIT_GLOBAL</option><option value="enabled">JYES</option><option value="disabled">JNO</option></field>
  <field name="mail_certificate" type="list" label="COM_JLMS_MAIL_CERTIFICATE_ENABLED" default="inherit" filter="cmd"><option value="inherit">COM_JLMS_MAIL_INHERIT_GLOBAL</option><option value="enabled">JYES</option><option value="disabled">JNO</option></field>
  <field name="mail_communication" type="list" label="COM_JLMS_MAIL_COMMUNICATION_ENABLED" default="inherit" filter="cmd"><option value="inherit">COM_JLMS_MAIL_INHERIT_GLOBAL</option><option value="enabled">JYES</option><option value="disabled">JNO</option></field>
  <field name="certificate_enabled" type="list" label="COM_JLMS_CERTIFICATE_ENABLED" description="COM_JLMS_CERTIFICATE_ENABLED_DESC" default="inherit" filter="cmd"><option value="inherit">COM_JLMS_CERTIFICATE_INHERIT_GLOBAL</option><option value="enabled">JYES</option><option value="disabled">JNO</option></field>
 </fieldset>
 <fieldset name="metadata" label="COM_JLMS_COURSE_METADATA">
  <field name="presentation_seo_title" type="text" label="COM_JLMS_COURSE_SEO_TITLE" maxlength="255" filter="raw" />
  <field name="presentation_seo_description" type="textarea" label="COM_JLMS_COURSE_SEO_DESCRIPTION" rows="3" maxlength="500" filter="raw" />
 </fieldset>
 <fieldset name="calendar" label="COM_JLMS_CALENDAR">
  <field name="calendar_timezone" type="timezone" label="COM_JLMS_CALENDAR_ZONE" description="COM_JLMS_CALENDAR_HELP" default="" filter="raw"><option value="">COM_JLMS_CALENDAR_USE_GLOBAL</option></field>
  <field name="calendar_publish_up" type="calendar" label="COM_JLMS_CALENDAR_PUBLISH_UP" format="%Y-%m-%d %H:%M:%S" translateformat="false" showtime="true" timeformat="24" filter="raw" />
  <field name="calendar_publish_down" type="calendar" label="COM_JLMS_CALENDAR_PUBLISH_DOWN" format="%Y-%m-%d %H:%M:%S" translateformat="false" showtime="true" timeformat="24" filter="raw" />
  <field name="calendar_starts_at" type="calendar" label="COM_JLMS_CALENDAR_START" format="%Y-%m-%d %H:%M:%S" translateformat="false" showtime="true" timeformat="24" filter="raw" />
  <field name="calendar_ends_at" type="calendar" label="COM_JLMS_CALENDAR_END" format="%Y-%m-%d %H:%M:%S" translateformat="false" showtime="true" timeformat="24" filter="raw" />
 </fieldset>
 <fieldset name="publication" label="COM_JLMS_PUBLICATION_HEADING">
  <field name="state" type="list" label="JSTATUS" disabled="true" default="0"><option value="0">JUNPUBLISHED</option><option value="1">JPUBLISHED</option></field>
 </fieldset>
 <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
  <field name="asset_id" type="hidden" filter="unset" />
  <field name="rules" type="rules" component="com_jlms" section="course" label="JCONFIG_PERMISSIONS_LABEL" filter="unset" />
 </fieldset>
</form>

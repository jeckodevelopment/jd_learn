<?xml version="1.0" encoding="utf-8"?>
<form>
 <fieldset name="details" label="COM_JLMS_PATHWAY">
  <field name="id" type="hidden" filter="integer" default="0" />
  <field name="revision" type="hidden" filter="integer" default="1" />
  <field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" filter="string" />
  <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" maxlength="180" filter="string" />
  <field name="description" type="editor" label="COM_JLMS_PATHWAY_DESCRIPTION" buttons="true" filter="raw" />
  <field name="catid" type="category" label="JCATEGORY" extension="com_jlms.pathway" required="true" filter="integer" />
  <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" default="1" required="true" filter="integer" />
  <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL" default="*"><option value="*">JALL</option></field>
  <field name="state" type="list" label="JSTATUS" default="0" filter="integer"><option value="0">JUNPUBLISHED</option><option value="1">JPUBLISHED</option></field>
 </fieldset>
 <fieldset name="courses" label="COM_JLMS_PATHWAY_COURSES">
  <field name="courses" type="subform" label="COM_JLMS_PATHWAY_COURSES" description="COM_JLMS_PATHWAY_COURSES_DESC" multiple="true" min="0" max="100" layout="joomla.form.field.subform.repeatable-table" filter="Subform" validate="Subform"><form>
   <field name="course_id" type="sql" label="COM_JLMS_PATHWAY_COURSE" required="true" query="SELECT id AS value, title AS text FROM #__jlms_courses ORDER BY title, id" key_field="value" value_field="text" filter="integer" />
   <field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" min="0" max="9999" filter="integer" />
  </form></field>
 </fieldset>
</form>
